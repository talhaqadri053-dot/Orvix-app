# Leave blank to use the platform-aware local XAMPP URL from src/config/api.js.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Set one explicit URL only when testing a single target:
# Browser: http://localhost/orvix/orvixone/public/api/v1
# Android emulator: http://10.0.2.2/orvix/orvixone/public/api/v1
# Physical device: http://192.168.1.159/orvix/orvixone/public/api/v1
